<?xml version="1.0" encoding="UTF-8"?>

<component name="com.aritu.eloraplm.bom.characteristics.EventServiceComponent.contrib">
   
    <extension target="org.nuxeo.ecm.core.event.EventServiceComponent" point="listener">
        
        <!-- loadBomCharacteristicsListener -->
        <listener name="loadBomCharacteristicsListener" async="false" postCommit="false" 
                  class="com.aritu.eloraplm.bom.characteristics.listener.LoadBomCharacteristicsListener" priority="150">
            <event>documentCreated</event>
            <event>beforeDocumentModification</event>
            <event>PdmCheckedOutEvent</event>
        </listener>
        
        <!-- updateLinkedCharacteristicsOnOverwriteListener -->
        <listener name="updateLinkedCharacteristicsOnOverwriteListener" async="true" postCommit="true"
                class="com.aritu.eloraplm.bom.linked.characteristics.listener.UpdateLinkedCharacteristicsOnOverwriteListener" priority="250" enabled="${com.aritu.eloraplm.viewer.enabled}">
            <event>PdmOverwrittenEvent</event>
        </listener>

    </extension>

</component>