<?xml version="1.0" encoding="UTF-8"?>

<component name="com.aritu.eloraplm.workflows.forms.ActionService.contrib">
    <require>org.nuxeo.ecm.platform.routing.actions</require>
    <require>com.aritu.eloraplm.workflows.ActionService.contrib</require>

    <extension point="filters" target="org.nuxeo.ecm.platform.actions.ActionService">
    
        <filter id="workflowQuestionsTableButtons">
            <rule grant="true">
                <condition>#{webActions.getCurrentTabId('MAIN_TABS') eq 'admin' and adminViews.getCurrentView() eq 'manageWorkflowForms'}</condition>
            </rule>
        </filter>
        
        <filter id="hasWorkflowForms">
            <rule grant="true">
                <facet>HasWorkflowForms</facet>
            </rule>
        </filter>
        
        <filter id="notWorkflowForms">
            <rule grant="false">
                <facet>HasWorkflowForms</facet>
            </rule>
        </filter>
        
    </extension>
    
    <extension point="actions" target="org.nuxeo.ecm.platform.actions.ActionService">
        
        <!-- Admin tab -->
        
        <action id="manageWorkflowForms"
            link="/incl/admin/manage_workflow_forms.xhtml"
            label="eloraplm.tab.admin.workflows.forms"
            type="admin_rest_document_link" order="130">
            <filter-id>WorkflowsEnabled</filter-id>
            <filter-id>adminCenterAccess</filter-id>
            <category>NUXEO_ADMIN</category>
        </action>
        
        <!-- ///////////////// -->
        
        <!-- Workflow tab (without forms) -->
        
        <action id="TAB_ROUTE_WORKFLOW" enabled="false" />
        
        <action id="TAB_WORKFLOWS_WITHOUT_FORMS" link="/incl/tabs/workflows_without_forms.xhtml"
            order="100" label="eloraplm.label.workflows"
            type="rest_document_link">
            <filter-id>WorkflowsEnabled</filter-id>
            <filter-id>notWorkflowForms</filter-id>
            <filter-id>hasRelatedWorkflowStarted</filter-id>
            <category>VIEW_ACTION_LIST</category>
        </action>
        
        
        <!-- Workflow tab (with forms) -->
        
        <action id="TAB_WORKFLOWS" link="/incl/tabs/workflows.xhtml"
            order="100" label="eloraplm.label.workflows" type="rest_document_link">
            <filter-id>WorkflowsEnabled</filter-id>
            <filter-id>hasWorkflowForms</filter-id>
            <category>VIEW_ACTION_LIST</category>
        </action>
    
        <!-- ///////////////// -->
        
        <!-- Datatable buttons -->
        
        <action id="btnAddWorkflowQuestion" order="20" label="eloraplm.command.workflows.forms.question.add" type="pfdialog" icon="">
            <category>DATATABLE_BUTTON</category>
            <filter-id>workflowQuestionsTableButtons</filter-id>
            <properties>
                <property name="include">/incl/action/add_workflow_question.xhtml</property>
                <property name="ajaxSupport">true</property>
                <property name="styleClass">button</property>
                <property name="dialogTitle">eloraplm.title.workflows.forms.question.add</property>
            </properties>
        </action>
        
        <action id="btnSaveWorkflowQuestions" order="30" label="command.save" type="link" link="#{workflowQuestionsTableBean.save()}" icon="">
            <category>DATATABLE_BUTTON</category>
            <filter-id>workflowQuestionsTableButtons</filter-id>
            <properties>
                <property name="ajaxSupport">true</property>
                <property name="styleClass">button mainAction</property>
            </properties>
        </action>
        
        <!-- ///////////////// -->
        
    </extension>
    
</component>
