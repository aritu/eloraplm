<?xml version="1.0" encoding="UTF-8"?>

<component name="com.aritu.eloraplm.drive.ActionService.contrib">
    <require>org.nuxeo.drive.actions</require>
    
    <extension point="filters" target="org.nuxeo.ecm.platform.actions.ActionService">
        
        <filter id="can_drive_edit">
            <rule grant="true">
                <condition>#{eloraDesktopActions.canEditDocument(document)}</condition>
            </rule>
            <rule grant="false">
                <facet>Collection</facet>
            </rule>
        </filter>
    
    </extension>
    
    <extension point="actions" target="org.nuxeo.ecm.platform.actions.ActionService">
        
        <!-- Disable Nuxeo Drive folder/document synchronization completely -->
        <action id="driveSynchronizeCurrentDocument" enabled="${com.aritu.eloraplm.drive.sync.enabled}" />
        
        <action icon="/icons/drive_edit.png" id="driveEdit" label="command.driveEdit" link="#{eloraDesktopActions.driveEditURL}" order="200" type="bare_link">
            <category>BLOB_ACTIONS</category>
            <filter-id>has_one_auth_token</filter-id>
            <filter-id>can_drive_edit</filter-id>
            <filter-id>isMainBlob</filter-id>
            <filter-id>isBomOrBasicDocument</filter-id>
            <filter-id>isCheckedOut</filter-id>
        </action>
        
        <action icon="/icons/drive_edit.png" id="driveEditUserCenterNuxeoDrive" label="command.driveEdit" link="#{eloraDesktopActions.navigateToUserCenterEloraDesktop}" order="50">
            <category>BLOB_ACTIONS</category>
            <filter-id>has_no_auth_token</filter-id>
            <filter-id>can_drive_edit</filter-id>
            <filter-id>isMainBlob</filter-id>
            <filter-id>isBomOrBasicDocument</filter-id>
            <filter-id>isCheckedOut</filter-id>
        </action>
        
        <!-- Disable Home menu -->
        <action id="userCenterNuxeoDrive" enabled="false" />
        
        <!-- Elora Desktop in Home menu -->
        <action id="userCenterEloraDesktop" link="/incl/eloradesktop/user_center_elora_desktop.xhtml"
            label="eloraplm.label.user.center.eloraDesktop" icon="/icons/drive_tab.png" order="100">
            <category>USER_CENTER</category>
        </action>
        
    </extension>
    
</component>
