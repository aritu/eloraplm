<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:ref="http://www.nuxeo.org/ecm/schemas/core/external-references/" 
    xmlns:nxs="http://www.nuxeo.org/ecm/project/schemas/related_oem" 
    targetNamespace="http://www.nuxeo.org/ecm/project/schemas/related_oem"
    xmlns:nxsv="http://www.nuxeo.org/ecm/schemas/core/validation/">
    
    <xs:complexType name="oemType">
        <xs:sequence>
            <xs:element name="manufacturer">
                <xs:simpleType>
                    <xs:restriction base="xs:string" ref:resolver="directoryResolver" ref:directory="elora_erpOems" />
                </xs:simpleType>
            </xs:element>
            <xs:element name="preference" type="xs:integer"/>
            <xs:element name="partNumber" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>
    
    <xs:complexType name="oemListType">
        <xs:sequence>
            <xs:element name="oem" type="nxs:oemType" minOccurs="0" maxOccurs="unbounded" />
        </xs:sequence>
    </xs:complexType>
    
    <xs:element name="oems" type="nxs:oemListType"/>
    
</xs:schema>
