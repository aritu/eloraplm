<?xml version="1.0" encoding="UTF-8"?>

<component name="com.aritu.eloraplm.core.EventServiceComponent.contrib">
    
    <extension target="org.nuxeo.ecm.core.event.EventServiceComponent" point="listener">
        
        <!-- orderingPriorityListener -->
        <listener name="orderingPriorityListener" async="false" postCommit="false" 
                class="com.aritu.eloraplm.core.listener.OrderingPriorityListener" priority="150">
            <event>documentCreated</event>
        </listener>
        
        <!-- DocumentReviewInfoUpdaterListener -->
        <listener name="DocumentReviewInfoUpdaterListener" async="false" postCommit="false" 
                class="com.aritu.eloraplm.core.listener.DocumentReviewInfoUpdaterListener" priority="150">
            <event>lifecycle_transition_event</event>
        </listener>
        
        <!-- StateLogListener -->
        <listener name="StateLogListener" async="false" postCommit="false" 
                class="com.aritu.eloraplm.core.listener.StateLogListener" priority="200">
            <event>lifecycle_transition_event</event>
            <event>documentCreated</event>
            <event>PdmCheckedInEvent</event>
            <event>documentCreatedByCopy</event>
            <event>PdmOverwrittenEvent</event>
            <event>DocumentEloraCreatedInsideTemplate</event>
        </listener>
        
        <!-- DocFinalStateListener -->
        <listener name="DocFinalStateListener" async="false" postCommit="false" 
                class="com.aritu.eloraplm.core.listener.DocFinalStateListener" priority="250">
            <event>lifecycle_transition_event</event>
        </listener>
        
        <!-- The listener is disabled because the cleanup ends in timeout and we do not know how to solve this issue for now -->
        <!-- 
        <listener name="orphanBinariesCleanup" async="true" postCommit="true"
                class="com.aritu.eloraplm.core.OrphanBinaryCleanupListener">
            <event>orphanBinariesCleanup</event>
        </listener>
        -->
        
        <!-- MetadataMappingDestinationDocumentListener -->
        <listener name="MetadataMappingDestinationDocumentListener" async="false" postCommit="false" 
                class="com.aritu.eloraplm.core.listener.MetadataMappingDestinationDocumentListener" priority="100">
            <event>PdmAboutToCheckInEvent</event>
            <event>PdmAboutToOverwriteEvent</event>
        </listener>
        
        <!-- LaunchMetadataMappingDestinationListener ASYNC -->
        <listener name="MetadataMappingDestinationDocumentAsyncListener" async="true" postCommit="true" 
                class="com.aritu.eloraplm.core.listener.MetadataMappingDestinationDocumentAsyncListener" priority="100">
            <event>LaunchMetadataMappingDestinationListener</event>
        </listener>
        
        <!-- MetadataMappingOriginDocumentListener -->
        <listener name="MetadataMappingOriginDocumentListener" async="false" postCommit="false" 
                class="com.aritu.eloraplm.core.listener.MetadataMappingOriginDocumentListener" priority="100">
            <event>PdmOverwrittenEvent</event>
        </listener>
        
        <!-- LaunchMetadataMappingOriginListener ASYNC -->
        <listener name="MetadataMappingOriginDocumentAsyncListener" async="true" postCommit="true" 
                  class="com.aritu.eloraplm.core.listener.MetadataMappingOriginDocumentAsyncListener" priority="40">
            <event>LaunchMetadataMappingOriginListener</event>
        </listener>
        
    </extension>
    
</component>