<?xml version="1.0" encoding="UTF-8"?>

<component name="com.aritu.eloraplm.securitypolicy.WebLayoutManager.contrib">

  <require>org.nuxeo.ecm.platform.forms.layouts.webapp.base</require>

  <extension target="org.nuxeo.ecm.platform.forms.layout.WebLayoutManager" point="widgets">
    
    <widget name="header_security_level_info" type="template">
        <labels>
            <label mode="any"></label>
        </labels>
        <fields>
            <field>sec:securityLevel</field>
        </fields>
        <properties mode="any">
            <property name="template">/widgets/security_level_widget.xhtml</property>
        </properties>
    </widget>
    
    <widget name="group_securityLevel" type="int">
      <labels>
        <label mode="any">label.groupManager.groupSecurityLevel</label>
      </labels>
      <translated>true</translated>
      <fields>
        <field schema="group">securityLevel</field>
      </fields>
      <properties widgetMode="edit">
        <property name="styleClass">dataInputText</property>
      </properties>
    </widget>
    
  </extension>
  
  <extension target="org.nuxeo.ecm.platform.forms.layout.WebLayoutManager" point="layouts">
    
    <layout name="group">
      <templates>
        <template mode="any">/layouts/layout_default_template.xhtml
        </template>
      </templates>
      <rows>
        <row>
          <widget>group_name</widget>
        </row>
        <row>
          <widget>group_label</widget>
        </row>
        <row>
          <widget>group_members</widget>
        </row>
        <row>
          <widget>group_subgroups</widget>
        </row>
        <row>
          <widget>group_securityLevel</widget>
        </row>
      </rows>
    </layout>
    
   </extension>

</component>  