<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" 
    xmlns:ref="http://www.nuxeo.org/ecm/schemas/core/external-references/"
    xmlns:nxs="http://www.nuxeo.org/ecm/project/schemas/security_info" 
    targetNamespace="http://www.nuxeo.org/ecm/project/schemas/security_info">
    
    <xs:include schemaLocation="core-types.xsd" />
    
    <xs:element name="securityViewerFile" type="nxs:content" />
    <xs:element name="securityLevel" type="xs:integer" default="1" />
    <xs:element name="securitySetDate" type="xs:date" />

    <xs:element name="securitySetBy">
      <xs:simpleType>
        <xs:restriction base="xs:string" ref:resolver="userManagerResolver" ref:type="user" />
      </xs:simpleType>
    </xs:element>
    
</xs:schema>
