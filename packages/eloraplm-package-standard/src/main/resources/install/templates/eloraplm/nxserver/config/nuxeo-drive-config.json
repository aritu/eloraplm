{
    "delay": 30,
    "ignored_prefixes": [".", "icon\r", "thumbs.db", "desktop.ini", "~$"],
    "ignored_suffixes": [
        ".bak",
        ".crdownload",
        ".dwl",
        ".dwl2",
        ".lnk",
        ".lock",
        ".nxpart",
        ".part",
        ".partial",
        ".swp",
        ".tmp",
        "~"
    ],
    "ignored_files": ["^atmp\\d+$"],
    "log_level_file": "DEBUG",
    "timeout": 30,
    "handshake_timeout": 60,
    "beta_channel": false,
    "behavior": {
        "server_deletion": false
    },
    "chunk_upload": false,
    "feature": {
        "auto_update": false,
        "direct_edit": true,
        "direct_transfer": false,
        "s3": false
    },
    "synchronization_enabled": false,
    "ui": "jsf",
    "update_site_url": "https//drive-updates.eloraplm.com/",
    "use_analytics": false,
    "custom-metrics": false
}
